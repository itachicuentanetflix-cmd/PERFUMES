# Cadena de conexión de Neon (usa la "Pooled connection")
DATABASE_URL=postgresql://usuario:clave@host-pooler.neon.tech/neondb?sslmode=require
# Texto largo y aleatorio (mínimo 32 caracteres) para firmar las sesiones
AUTH_SECRET=cambia-esto-por-un-texto-largo-y-aleatorio-123456
# Usuarios del sistema: usuario:clave separados por coma
APP_USERS=jean:CambiaEstaClave
